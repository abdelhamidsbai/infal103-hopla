{
  "name": "INFAL103 - Hopla Market",
  "image": "ghcr.io/srl-labs/containerlab/devcontainer-dind-slim:0.82.0",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8080, 3001],
  "portsAttributes": {
    "8080": { "label": "Site Hopla (load balancer)" },
    "3001": { "label": "Supervision (Uptime Kuma)" }
  },
  "customizations": {
    "vscode": { "extensions": ["hashicorp.terraform", "redhat.ansible"] }
  }
}
